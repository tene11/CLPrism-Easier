@@ -24,6 +24,7 @@
 #include <QJsonArray>
 #include <QJsonDocument>
 #include <QJsonObject>
+#include <QRegularExpression>
 
 #include <algorithm>
 
@@ -43,6 +44,13 @@ constexpr auto CLEANROOM_UID = "net.minecraftforge";
 constexpr auto LWJGL_UID = "org.lwjgl";
 constexpr auto MINECRAFT_UID = "net.minecraft";
 
+//! A component uid becomes a file name (patches/<uid>.json), so it must not be able to point anywhere else.
+bool isSafeUid(const QString& uid)
+{
+    static const QRegularExpression pattern("^[A-Za-z0-9][A-Za-z0-9._-]*$");
+    return pattern.match(uid).hasMatch() && !uid.contains("..");
+}
+
 QString describeProblems(const VersionFilePtr& file)
 {
     QStringList lines;
@@ -90,6 +98,8 @@ std::optional<InstancePackage> readInstancePackage(const QString& extractedDir,
 
     InstancePackage package;
     for (const QString& uid : order) {
+        if (!isSafeUid(uid))
+            return fail(QObject::tr("The downloaded file contains an invalid component name: \"%1\".").arg(uid));
         if (uid == MINECRAFT_UID)
             continue;  // never replace Minecraft itself
 
@@ -204,8 +214,10 @@ bool uninstall(PackProfile* profile, const QString& forgeVersion, QString* error
     QStringList stubJars;
     if (const auto file = cleanroom->getVersionFile()) {
         for (const auto& library : file->libraries) {
-            if (library->isLocal())
-                stubJars << library->rawName().getFileName();
+            // only plain "<name>.jar" file names: never delete anything outside the library folder
+            const QString jar = library->rawName().getFileName();
+            if (library->isLocal() && jar.endsWith(".jar") && QFileInfo(jar).fileName() == jar && !jar.contains(".."))
+                stubJars << jar;
         }
     }
 
