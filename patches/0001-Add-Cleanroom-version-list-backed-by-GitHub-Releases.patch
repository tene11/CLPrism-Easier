+#include "CleanroomVersionList.h"
+
+#include <QDebug>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+
+#include "Application.h"
+#include "meta/VersionList.h"
+#include "net/Download.h"
+
+namespace Cleanroom {
+
+// ---------------------------------------------------------------------------
+// Version
+// ---------------------------------------------------------------------------
+
+QString Version::typeString() const
+{
+    if (prerelease)
+        return QObject::tr("Pre-release");
+    // Cleanroom marks its maturity in the tag ("0.7.11-alpha") instead of the GitHub pre-release flag
+    if (tag.contains("alpha", Qt::CaseInsensitive))
+        return QObject::tr("Alpha");
+    if (tag.contains("beta", Qt::CaseInsensitive))
+        return QObject::tr("Beta");
+    return QObject::tr("Release");
+}
+
+// ---------------------------------------------------------------------------
+// VersionListLoadTask
+// ---------------------------------------------------------------------------
+
+VersionListLoadTask::VersionListLoadTask(VersionList* list) : Task(), m_list(list) {}
+
+bool VersionListLoadTask::abort()
+{
+    if (m_job)
+        m_job->abort();
+    return Task::abort();
+}
+
+void VersionListLoadTask::executeTask()
+{
+    setStatus(tr("Fetching Cleanroom releases from GitHub..."));
+
+    m_job = makeShared<NetJob>("Cleanroom::VersionList", APPLICATION->network());
+    auto [download, response] = Net::Download::makeByteArray(QUrl(RELEASES_URL));
+    m_response = response;
+    m_job->addNetAction(download);
+
+    connect(m_job.get(), &NetJob::succeeded, this, &VersionListLoadTask::onDownloadSucceeded);
+    connect(m_job.get(), &NetJob::failed, this, [this](QString reason) {
+        m_job.reset();
+        emitFailed(tr("Couldn't fetch the Cleanroom release list from GitHub: %1").arg(reason));
+    });
+    connect(m_job.get(), &NetJob::aborted, this, [this] {
+        m_job.reset();
+        emitAborted();
+    });
+    connect(m_job.get(), &NetJob::progress, this, &Task::setProgress);
+
+    m_job->start();
+}
+
+void VersionListLoadTask::onDownloadSucceeded()
+{
+    // move the data out first: the buffer belongs to the NetJob
+    const QByteArray data = std::move(*m_response);
+    m_response = nullptr;
+    m_job.reset();
+
+    QString error;
+    auto versions = VersionList::parseReleases(data, &error);
+    if (!error.isEmpty()) {
+        emitFailed(error);
+        return;
+    }
+
+    if (m_list)
+        m_list->setVersions(std::move(versions));
+    emitSucceeded();
+}
+
+// ---------------------------------------------------------------------------
+// VersionList
+// ---------------------------------------------------------------------------
+
+VersionList::VersionList(QObject* parent) : BaseVersionList(parent) {}
+
+Task::Ptr VersionList::getLoadTask([[maybe_unused]] bool forceReload)
+{
+    // reuse a running load instead of hitting the GitHub API twice.
+    // VersionSelectWidget only asks for a task when the list isn't loaded yet or on "Refresh",
+    // so every other call should fetch again.
+    if (m_loadTask && m_loadTask->isRunning())
+        return m_loadTask;
+
+    m_loadTask = makeShared<VersionListLoadTask>(this);
+    return m_loadTask;
+}
+
+QVariant VersionList::data(const QModelIndex& index, int role) const
+{
+    if (!index.isValid() || index.row() < 0 || index.row() >= count())
+        return {};
+
+    const auto& version = m_versions.at(index.row());
+    switch (role) {
+        case VersionPointerRole:
+            return QVariant::fromValue(std::static_pointer_cast<BaseVersion>(version));
+        case VersionRole:
+        case VersionIdRole:
+            return version->tag;
+        case ParentVersionRole:
+            // lets the dialog's "same Minecraft version" filter hide Cleanroom on non-1.12.2 instances
+            return QString(MINECRAFT_VERSION);
+        case TypeRole:
+            return version->typeString();
+        case RecommendedRole:
+            return version->tag == m_recommendedTag;
+        case LatestRole:
+            return index.row() == 0;
+        case Meta::VersionList::TimeRole:
+            return version->publishedAt;
+        case SortRole:
+            return version->publishedAt.toMSecsSinceEpoch();
+        default:
+            return {};
+    }
+}
+
+BaseVersionList::RoleList VersionList::providesRoles() const
+{
+    return { VersionPointerRole, VersionRole,     VersionIdRole, ParentVersionRole,           TypeRole,
+             RecommendedRole,    LatestRole,      SortRole,      Meta::VersionList::TimeRole };
+}
+
+Version::Ptr VersionList::findCleanroomVersion(const QString& tag) const
+{
+    for (const auto& version : m_versions) {
+        if (version->tag == tag)
+            return version;
+    }
+    return nullptr;
+}
+
+void VersionList::setVersions(QList<Version::Ptr> versions)
+{
+    beginResetModel();
+    m_versions = std::move(versions);
+
+    // recommend the newest release that isn't flagged as a GitHub pre-release
+    m_recommendedTag.clear();
+    for (const auto& version : m_versions) {
+        if (!version->prerelease) {
+            m_recommendedTag = version->tag;
+            break;
+        }
+    }
+
+    m_loaded = true;
+    endResetModel();
+}
+
+QList<Version::Ptr> VersionList::parseReleases(const QByteArray& json, QString* error)
+{
+    QJsonParseError parseError{};
+    const QJsonDocument doc = QJsonDocument::fromJson(json, &parseError);
+    if (parseError.error != QJsonParseError::NoError) {
+        if (error)
+            *error = tr("Couldn't parse the GitHub response: %1").arg(parseError.errorString());
+        return {};
+    }
+
+    if (!doc.isArray()) {
+        // GitHub answers with {"message": "..."} on errors such as rate limiting
+        const QString message = doc.object().value("message").toString();
+        if (error)
+            *error = message.isEmpty() ? tr("Unexpected response from GitHub.") : tr("GitHub: %1").arg(message);
+        return {};
+    }
+
+    QList<Version::Ptr> result;
+    for (const QJsonValue& releaseValue : doc.array()) {
+        const QJsonObject release = releaseValue.toObject();
+        if (release.value("draft").toBool())
+            continue;
+
+        const QString tag = release.value("tag_name").toString();
+        if (tag.isEmpty())
+            continue;
+
+        // Find the MMC instance zip. Its name has changed between releases
+        // ("Cleanroom-MMC-instance-*.zip", "cleanroom-<version>.zip"), so match loosely and prefer "mmc".
+        QJsonObject zipAsset;
+        for (const QJsonValue& assetValue : release.value("assets").toArray()) {
+            const QJsonObject asset = assetValue.toObject();
+            const QString name = asset.value("name").toString().toLower();
+            if (!name.endsWith(".zip") || !name.contains("cleanroom"))
+                continue;
+            if (zipAsset.isEmpty() || name.contains("mmc"))
+                zipAsset = asset;
+        }
+        if (zipAsset.isEmpty()) {
+            qDebug() << "Cleanroom release" << tag << "has no MMC instance zip, skipping";
+            continue;
+        }
+
+        auto version = std::make_shared<Version>();
+        version->tag = tag;
+        version->publishedAt = QDateTime::fromString(release.value("published_at").toString(), Qt::ISODate);
+        version->prerelease = release.value("prerelease").toBool();
+        version->zipUrl = QUrl(zipAsset.value("browser_download_url").toString());
+        version->zipName = zipAsset.value("name").toString();
+        version->zipSize = zipAsset.value("size").toVariant().toLongLong();
+        result.append(version);
+    }
+    return result;
+}
+
+}  // namespace Cleanroom
