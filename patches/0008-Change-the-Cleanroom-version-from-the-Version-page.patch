+//! "Change version" on Cleanroom: pick another Cleanroom release (not a Forge version, which its uid would offer)
+//! and install it like the Install Loader dialog does.
+static void changeCleanroomVersion(QWidget* parent, PackProfile* profile, const ComponentPtr& cleanroom)
+{
+    Cleanroom::VersionList versions;
+    VersionSelectDialog select(&versions, QObject::tr("Change %1 version").arg(cleanroom->getName()), parent);
+    select.setEmptyString(QObject::tr("No Cleanroom versions are currently available."));
+    select.setEmptyErrorString(QObject::tr("Couldn't load the Cleanroom versions from GitHub!"));
+    select.setCurrentVersion(cleanroom->getVersion());
+    if (!select.exec() || !select.selectedVersion())
+        return;
+
+    const QString selected = select.selectedVersion()->descriptor();
+    if (selected == cleanroom->getVersion()) {
+        // installing the same version again is how a broken install is repaired, so allow it, but ask
+        const auto answer = CustomMessageBox::selectable(parent, QObject::tr("Reinstall Cleanroom?"),
+                                                         QObject::tr("Cleanroom %1 is already installed.\n"
+                                                                     "Do you want to download and install it again?")
+                                                             .arg(selected),
+                                                         QMessageBox::Question, QMessageBox::Yes | QMessageBox::No, QMessageBox::No)
+                                ->exec();
+        if (answer != QMessageBox::Yes)
+            return;
+    }
+
+    qDebug() << "Change Cleanroom" << cleanroom->getVersion() << "to" << selected;
+    Cleanroom::installWithDialogs(parent, profile, select.selectedVersion());
+}
