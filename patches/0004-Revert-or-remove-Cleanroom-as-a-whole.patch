+// ---------------------------------------------------------------------------
+// Removing it again
+// ---------------------------------------------------------------------------
+
+bool isCleanroom(const ComponentPtr& component)
+{
+    return component && component->getID() == CLEANROOM_UID && component->isCustom() && component->getName() == "Cleanroom";
+}
+
+void resetAutomaticJava(MinecraftInstance* instance)
+{
+    auto settings = instance->settings();
+    if (APPLICATION->settings()->get("AutomaticJavaSwitch").toBool() && settings->get("AutomaticJava").toBool() &&
+        settings->get("OverrideJavaLocation").toBool()) {
+        settings->set("OverrideJavaLocation", false);
+        settings->set("JavaPath", "");
+    }
+}
+
+bool uninstall(PackProfile* profile, const QString& forgeVersion, QString* error)
+{
+    auto fail = [error](const QString& reason) {
+        if (error)
+            *error = reason;
+        return false;
+    };
+
+    const auto cleanroom = profile->getComponent(CLEANROOM_UID);
+    if (!isCleanroom(cleanroom))
+        return fail(QObject::tr("Cleanroom isn't installed in this instance."));
+
+    // remember Cleanroom's stub jars ("MMC-hint": "local" libraries) before its patch is gone
+    QStringList stubJars;
+    if (const auto file = cleanroom->getVersionFile()) {
+        for (const auto& library : file->libraries) {
+            if (library->isLocal())
+                stubJars << library->rawName().getFileName();
+        }
+    }
+
+    if (!profile->remove(CLEANROOM_UID))
+        return fail(QObject::tr("Couldn't remove the Cleanroom component."));
+
+    // the LWJGL 3 patch that came with Cleanroom. Minecraft requires org.lwjgl, so resolving the profile adds LWJGL 2 back.
+    if (const auto lwjgl = profile->getComponent(LWJGL_UID); lwjgl && lwjgl->isCustom() && !profile->remove(LWJGL_UID))
+        return fail(QObject::tr("Couldn't remove the LWJGL 3 component."));
+
+    const QString libDir = profile->instance()->getLocalLibraryPath();
+    for (const QString& jar : stubJars) {
+        const QString path = FS::PathCombine(libDir, jar);
+        if (QFileInfo::exists(path) && !QFile::remove(path))
+            qWarning() << "Couldn't delete Cleanroom stub jar" << path;  // harmless leftover, nothing refers to it anymore
+    }
+
+    if (!forgeVersion.isEmpty())
+        profile->setComponentVersion(CLEANROOM_UID, forgeVersion);
+
+    profile->invalidateLaunchProfile();
+    return true;
+}
+
