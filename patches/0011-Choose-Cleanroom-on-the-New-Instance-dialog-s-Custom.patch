 .../cleanroom/CleanroomCreationTask.cpp       | 90 +++++++++++++++++++
 .../cleanroom/CleanroomCreationTask.h         | 46 ++++++++++
 launcher/ui/pages/modplatform/CustomPage.cpp  | 28 +++++-
 launcher/ui/pages/modplatform/CustomPage.h    |  6 ++
 launcher/ui/pages/modplatform/CustomPage.ui   | 10 +++
 6 files changed, 180 insertions(+), 2 deletions(-)
 create mode 100644 launcher/minecraft/cleanroom/CleanroomCreationTask.cpp
