+#pragma once
+
+#include <QPointer>
+#include <QStringList>
+#include <QTemporaryDir>
+
+#include <optional>
+
+#include "minecraft/VersionFile.h"
+#include "minecraft/cleanroom/CleanroomVersionList.h"
+#include "net/NetJob.h"
+#include "tasks/Task.h"
+
+class PackProfile;
+
+namespace Cleanroom {
+
+//! The components of a Cleanroom MMC instance zip, checked and ready to be installed.
+struct InstancePackage {
+    struct Patch {
+        QString uid;
+        QString jsonPath;  //!< patches/<uid>.json inside the extracted zip
+        VersionFilePtr file;
+    };
+    QList<Patch> patches;     //!< in the order of the zip's mmc-pack.json (org.lwjgl before net.minecraftforge)
+    QStringList libraryJars;  //!< libraries/*.jar inside the extracted zip (the "999999.0-empty" stubs)
+};
+
+//! Read and validate an extracted Cleanroom MMC instance zip.
+//! On failure returns std::nullopt and writes the reason to \p error.
+std::optional<InstancePackage> readInstancePackage(const QString& extractedDir, QString* error);
+
+//! Install a package into \p profile: copy the stub jars to the instance's local library folder and
+//! replace the components with the package's patches. On failure writes the reason to \p error.
+bool installPackage(PackProfile* profile, const InstancePackage& package, QString* error);
+
+//! Downloads a Cleanroom MMC instance zip and installs its components into a PackProfile:
+//! the bundled org.lwjgl (LWJGL 3) and net.minecraftforge (Cleanroom) patches replace the existing
+//! components, and the empty stub jars go to the instance's local library folder.
+//! The caller should resolve the profile afterwards.
+class InstallTask : public Task {
+    Q_OBJECT
+   public:
+    InstallTask(PackProfile* profile, Version::Ptr version);
+
+    bool canAbort() const override { return true; }
+    bool abort() override;
+
+    //! The installed Cleanroom patch, valid after the task succeeded.
+    VersionFilePtr installedCleanroom() const { return m_installedCleanroom; }
+
+   protected:
+    void executeTask() override;
+
+   private slots:
+    void onDownloadSucceeded();
+
+   private:
+    QPointer<PackProfile> m_profile;
+    Version::Ptr m_version;
+    NetJob::Ptr m_job;
+    QTemporaryDir m_tempDir;
+    QString m_zipPath;
+    VersionFilePtr m_installedCleanroom;
+};
+
+}  // namespace Cleanroom
