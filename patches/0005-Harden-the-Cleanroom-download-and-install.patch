+// SPDX-License-Identifier: GPL-3.0-only
+
+#include <QDir>
+#include <QFile>
+#include <QTemporaryDir>
+#include <QTest>
+
+#include "minecraft/cleanroom/CleanroomInstallTask.h"
+
+class CleanroomInstallTest : public QObject {
+    Q_OBJECT
+
+    static void write(const QString& path, const QByteArray& data)
+    {
+        QDir().mkpath(QFileInfo(path).absolutePath());
+        QFile file(path);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write(data);
+    }
+
+   private slots:
+    void test_rejectsPathLikeUids_data()
+    {
+        QTest::addColumn<QString>("uid");
+        QTest::newRow("parent folder") << "../../evil";
+        QTest::newRow("absolute path") << "/tmp/evil";
+        QTest::newRow("backslash") << "..\\\\evil";
+        QTest::newRow("dot dot") << "net..evil";
+    }
+
+    void test_rejectsPathLikeUids()
+    {
+        QFETCH(QString, uid);
+        QTemporaryDir dir;
+        write(dir.filePath("mmc-pack.json"), QString(R"({"formatVersion": 1, "components": [{"uid": "%1"}]})").arg(uid).toUtf8());
+        write(dir.filePath("patches/net.minecraftforge.json"), "{}");
+
+        QString error;
+        QVERIFY(!Cleanroom::readInstancePackage(dir.path(), &error));
+        QVERIFY2(error.contains("invalid component name"), qPrintable(error));
+    }
+
+    void test_requiresCleanroomPatch()
+    {
+        QTemporaryDir dir;
+        write(dir.filePath("mmc-pack.json"), R"({"formatVersion": 1, "components": [{"uid": "net.minecraft"}]})");
+        QDir().mkpath(dir.filePath("patches"));
+
+        QString error;
+        QVERIFY(!Cleanroom::readInstancePackage(dir.path(), &error));
+        QVERIFY2(error.contains("net.minecraftforge"), qPrintable(error));
+    }
+};
+
+QTEST_GUILESS_MAIN(CleanroomInstallTest)
+
+#include "CleanroomInstall_test.moc"
