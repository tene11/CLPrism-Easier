+#pragma once
+
+#include <QDateTime>
+#include <QList>
+#include <QPointer>
+#include <QUrl>
+
+#include "BaseVersion.h"
+#include "BaseVersionList.h"
+#include "net/NetJob.h"
+#include "tasks/Task.h"
+
+namespace Cleanroom {
+
+//! ID of the "Cleanroom" page in the Install Loader dialog.
+//! Cleanroom itself installs as the "net.minecraftforge" component, so this is NOT a component uid.
+constexpr auto PAGE_ID = "cleanroom";
+
+//! The only Minecraft version Cleanroom supports.
+constexpr auto MINECRAFT_VERSION = "1.12.2";
+
+//! GitHub API endpoint listing Cleanroom releases (newest first).
+constexpr auto RELEASES_URL = "https://api.github.com/repos/CleanroomMC/Cleanroom/releases?per_page=100";
+
+//! One Cleanroom release on GitHub that ships a MultiMC/Prism instance zip.
+class Version : public BaseVersion {
+   public:
+    using Ptr = std::shared_ptr<Version>;
+
+    QString descriptor() const override { return tag; }
+    QString name() const override { return tag; }
+    QString typeString() const override;
+
+    QString tag;            //!< release tag, e.g. "0.7.11-alpha" (same as the component version)
+    QDateTime publishedAt;  //!< when the release was published
+    bool prerelease = false;
+    QUrl zipUrl;      //!< download URL of the MMC instance zip
+    QString zipName;  //!< file name of the MMC instance zip
+    qint64 zipSize = 0;
+};
+
+class VersionList;
+
+//! Downloads the release list from GitHub and fills a VersionList with it.
+class VersionListLoadTask : public Task {
+    Q_OBJECT
+   public:
+    explicit VersionListLoadTask(VersionList* list);
+
+    bool canAbort() const override { return true; }
+    bool abort() override;
+
+   protected:
+    void executeTask() override;
+
+   private slots:
+    void onDownloadSucceeded();
+
+   private:
+    QPointer<VersionList> m_list;
+    NetJob::Ptr m_job;
+    QByteArray* m_response = nullptr;
+};
+
+//! Version list for the "Cleanroom" page, backed by GitHub Releases instead of the Prism meta server.
+class VersionList : public BaseVersionList {
+    Q_OBJECT
+   public:
+    explicit VersionList(QObject* parent = nullptr);
+
+    Task::Ptr getLoadTask(bool forceReload = false) override;
+    bool isLoaded() override { return m_loaded; }
+    const BaseVersion::Ptr at(int i) const override { return m_versions.at(i); }
+    int count() const override { return static_cast<int>(m_versions.count()); }
+    void sortVersions() override {}  // sorted through SortRole (publish time)
+
+    QVariant data(const QModelIndex& index, int role) const override;
+    RoleList providesRoles() const override;
+
+    //! Find a version by its release tag. Returns nullptr if it isn't in the list.
+    Version::Ptr findCleanroomVersion(const QString& tag) const;
+
+    //! Parse the JSON returned by the GitHub releases API.
+    //! Releases without an MMC instance zip are skipped.
+    //! On failure, returns an empty list and writes the reason to \p error.
+    static QList<Version::Ptr> parseReleases(const QByteArray& json, QString* error);
+
+   protected slots:
+    void updateListData(QList<BaseVersion::Ptr>) override {}
+
+   private:
+    friend class VersionListLoadTask;
+    void setVersions(QList<Version::Ptr> versions);
+
+    QList<Version::Ptr> m_versions;
+    QString m_recommendedTag;
+    bool m_loaded = false;
+    Task::Ptr m_loadTask;
+};
+
+}  // namespace Cleanroom
