+//! Cleanroom can't be reverted like other components: its "base" would be a Forge version that doesn't exist.
+//! Replace it with the recommended regular Forge for this Minecraft version instead.
+static bool revertCleanroomToForge(QWidget* parent, PackProfile* profile)
+{
+    const auto cleanroom = profile->getComponent("net.minecraftforge");
+    const QString minecraftVersion = profile->getComponentVersion("net.minecraft");
+
+    const auto response = CustomMessageBox::selectable(parent, QObject::tr("Revert to Forge"),
+                                                       QObject::tr("You are about to revert Cleanroom %1 back to regular Forge.\n"
+                                                                   "The LWJGL 3 that came with Cleanroom will be removed and "
+                                                                   "Minecraft's own LWJGL 2 will be restored.\n\n"
+                                                                   "Are you sure?")
+                                                           .arg(cleanroom->getVersion()),
+                                                       QMessageBox::Warning, QMessageBox::Yes | QMessageBox::No, QMessageBox::No)
+                              ->exec();
+    if (response != QMessageBox::Yes)
+        return false;
+
+    // the recommended Forge for this Minecraft version, or the newest one
+    auto forgeVersions = APPLICATION->metadataIndex()->get("net.minecraftforge");
+    if (!forgeVersions->isLoaded()) {
+        auto task = forgeVersions->getLoadTask();
+        ProgressDialog progress(parent);
+        progress.execWithTask(task.get());
+    }
+    auto forge = forgeVersions->getRecommendedForParent("net.minecraft", minecraftVersion);
+    if (!forge)
+        forge = forgeVersions->getLatestForParent("net.minecraft", minecraftVersion);
+    if (!forge) {
+        QMessageBox::critical(parent, QObject::tr("Error"), QObject::tr("Couldn't find a Forge version for Minecraft %1.").arg(minecraftVersion));
+        return false;
+    }
+
+    QString error;
+    if (!Cleanroom::uninstall(profile, forge->descriptor(), &error)) {
+        QMessageBox::critical(parent, QObject::tr("Error"), error);
+        return false;
+    }
+    Cleanroom::resetAutomaticJava(profile->instance());  // let Prism choose a Java that Forge accepts again
+    profile->resolve(Net::Mode::Online);
+    return true;
+}
+
+//! Removing Cleanroom also removes the LWJGL 3 and stub jars it brought, which would break plain Minecraft.
+static bool removeCleanroom(QWidget* parent, PackProfile* profile)
+{
+    const auto cleanroom = profile->getComponent("net.minecraftforge");
+    const auto response = CustomMessageBox::selectable(parent, QObject::tr("Confirm Removal"),
+                                                       QObject::tr("You are about to remove Cleanroom %1.\n"
+                                                                   "The LWJGL 3 that came with it will be removed too and "
+                                                                   "Minecraft's own LWJGL 2 will be restored.\n\n"
+                                                                   "Are you sure?")
+                                                           .arg(cleanroom->getVersion()),
+                                                       QMessageBox::Warning, QMessageBox::Yes | QMessageBox::No, QMessageBox::No)
+                              ->exec();
+    if (response != QMessageBox::Yes)
+        return false;
+
+    QString error;
+    if (!Cleanroom::uninstall(profile, QString(), &error)) {
+        QMessageBox::critical(parent, QObject::tr("Error"), error);
+        return false;
+    }
+    Cleanroom::resetAutomaticJava(profile->instance());  // let Prism choose a Java that Minecraft accepts again
+    return true;
+}
+
+//! True if \p component is the LWJGL 3 that Cleanroom needs.
+static bool isCleanroomLwjgl(PackProfile* profile, const ComponentPtr& component)
+{
+    return component && component->getID() == "org.lwjgl" && component->isCustom() &&
+           Cleanroom::isCleanroom(profile->getComponent("net.minecraftforge"));
+}
