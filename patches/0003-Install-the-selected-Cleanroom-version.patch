+//! Ask before Cleanroom replaces a regular Forge install. Replacing an older Cleanroom needs no question.
+static bool confirmForgeReplacement(QWidget* parent, PackProfile* profile, const QString& cleanroomVersion)
+{
+    const auto forge = profile->getComponent("net.minecraftforge");
+    if (!forge || forge->getName() == "Cleanroom")
+        return true;
+
+    const auto answer = CustomMessageBox::selectable(parent, QObject::tr("Replace Forge?"),
+                                                     QObject::tr("This instance has %1 %2 installed.\n"
+                                                                 "Installing Cleanroom %3 will replace it.\n\n"
+                                                                 "Do you want to continue?")
+                                                         .arg(forge->getName(), forge->getVersion(), cleanroomVersion),
+                                                     QMessageBox::Question, QMessageBox::Yes | QMessageBox::No, QMessageBox::No)
+                            ->exec();
+    return answer == QMessageBox::Yes;
+}
+
+//! Cleanroom needs a much newer Java than Forge 1.12.2.
+//! Let the automatic Java mechanism pick again (like Prism does after a Minecraft version change),
+//! then warn if no compatible Java is going to be used.
+static void checkCleanroomJava(QWidget* parent, PackProfile* profile, const QString& cleanroomVersion, const VersionFilePtr& cleanroom)
+{
+    if (!cleanroom || cleanroom->compatibleJavaMajors.isEmpty())
+        return;
+    const QList<int> majors = cleanroom->compatibleJavaMajors;
+
+    auto* instance = profile->instance();
+    auto settings = instance->settings();
+    const bool autoSwitch = APPLICATION->settings()->get("AutomaticJavaSwitch").toBool();
+    const bool autoDownload = APPLICATION->settings()->get("AutomaticJavaDownload").toBool();
+
+    // forget the Java that was chosen automatically for Forge, so a compatible one is chosen on the next launch
+    if (autoSwitch && settings->get("AutomaticJava").toBool() && settings->get("OverrideJavaLocation").toBool()) {
+        settings->set("OverrideJavaLocation", false);
+        settings->set("JavaPath", "");
+    }
+
+    bool found = false;
+    QString fixedJava;
+    if (!autoSwitch || settings->get("OverrideJavaLocation").toBool()) {
+        // a fixed Java (set on the instance, or the global one) is used as is
+        const auto java = instance->getJavaVersion();
+        found = majors.contains(java.major());
+        if (java.major() > 0)
+            fixedJava = java.toString();
+    } else if (autoDownload) {
+        return;  // Prism downloads a compatible Java on launch
+    } else {
+        // Prism picks a compatible Java among the detected ones on launch: check that there is one
+        auto javas = APPLICATION->javalist();
+        auto task = javas->getLoadTask();
+        ProgressDialog progress(parent);
+        progress.execWithTask(task.get());
+        for (int i = 0; i < javas->count(); i++) {
+            const auto java = std::dynamic_pointer_cast<JavaInstall>(javas->at(i));
+            if (java && majors.contains(java->id.major())) {
+                found = true;
+                break;
+            }
+        }
+    }
+    if (found)
+        return;
+
+    QStringList majorNames;
+    for (int major : majors)
+        majorNames << QString::number(major);
+    const QString needed = majorNames.join(QObject::tr(" or "));
+
+    const QString text = fixedJava.isEmpty()
+                             ? QObject::tr("Cleanroom %1 needs Java %2, but it wasn't found on this computer.\n\n"
+                                           "Install Java %2, or turn on automatic Java download in Settings > Java.")
+                                   .arg(cleanroomVersion, needed)
+                             : QObject::tr("Cleanroom %1 needs Java %2, but this instance is set to use Java %3.\n\n"
+                                           "Change it in the instance's Settings > Java before launching.")
+                                   .arg(cleanroomVersion, needed, fixedJava);
+    CustomMessageBox::selectable(parent, QObject::tr("Java %1 is needed").arg(needed), text, QMessageBox::Warning)->exec();
+}
+
+//! Download the selected Cleanroom version and install it. Returns false if it was cancelled or failed.
+static bool installCleanroom(QWidget* parent, PackProfile* profile, const BaseVersion::Ptr& selected)
+{
+    const auto version = std::dynamic_pointer_cast<Cleanroom::Version>(selected);
+    if (!version)
+        return false;
+
+    if (!confirmForgeReplacement(parent, profile, version->tag))
+        return false;
+
+    auto task = makeShared<Cleanroom::InstallTask>(profile, version);
+    ProgressDialog progress(parent);
+    progress.execWithTask(task.get());
+    if (!task->wasSuccessful()) {
+        if (!task->failReason().isEmpty())  // empty when the user cancelled
+            CustomMessageBox::selectable(parent, QObject::tr("Error"),
+                                         QObject::tr("Couldn't install Cleanroom %1:\n%2").arg(version->tag, task->failReason()),
+                                         QMessageBox::Critical)
+                ->exec();
+        return false;
+    }
+
+    profile->resolve(Net::Mode::Online);
+    checkCleanroomJava(parent, profile, version->tag, task->installedCleanroom());
+    return true;
+}
