+ */
+
+#include "CleanroomCreationTask.h"
+
+#include <QEventLoop>
+
+#include <utility>
+
+#include "FileSystem.h"
+#include "minecraft/MinecraftInstance.h"
+#include "minecraft/PackProfile.h"
+#include "minecraft/cleanroom/CleanroomInstallTask.h"
+#include "settings/INISettingsObject.h"
+
+namespace Cleanroom {
+
+CreationTask::CreationTask(BaseVersion::Ptr minecraft, Version::Ptr cleanroom)
+    : InstanceCreationTask(), m_minecraft(std::move(minecraft)), m_cleanroom(std::move(cleanroom))
+{}
+
+bool CreationTask::abort()
+{
+    if (!canAbort())
+        return false;
+
+    if (m_installTask && m_installTask->isRunning())
+        m_installTask->abort();
+
+    return InstanceCreationTask::abort();
+}
+
+std::unique_ptr<MinecraftInstance> CreationTask::createInstance()
+{
+    setStatus(tr("Creating instance from version %1").arg(m_minecraft->name()));
+
+    auto inst = std::make_unique<MinecraftInstance>(
+        m_globalSettings, std::make_unique<INISettingsObject>(FS::PathCombine(m_stagingPath, "instance.cfg")), m_stagingPath);
+    SettingsObject::Lock lock(inst->settings());
+
+    // the same vanilla instance VanillaCreationTask makes
+    auto components = inst->getPackProfile();
+    components->buildingFromScratch();
+    components->setComponentVersion("net.minecraft", m_minecraft->descriptor(), true);
+
+    inst->setName(name());
+    inst->setIconKey(m_instIcon);
+
+    // then Cleanroom on top of it. There is no Forge or other LWJGL 3 to replace in a new instance,
+    // so none of the questions the Install Loader dialog asks are needed here.
+    m_installTask = makeShared<InstallTask>(components, m_cleanroom);
+    connect(m_installTask.get(), &Task::status, this, &Task::setStatus);
+    connect(m_installTask.get(), &Task::progress, this, &Task::setProgress);
+
+    QEventLoop loop;
+    connect(m_installTask.get(), &Task::finished, &loop, &QEventLoop::quit);
+    m_installTask->start();
+    if (m_installTask->isRunning())
+        loop.exec();
+
+    const bool succeeded = m_installTask->wasSuccessful();
+    const QString reason = m_installTask->failReason();
+    m_installTask.reset();
+
+    if (m_abort)
+        return nullptr;
+    if (!succeeded) {
+        //: %1 is the Cleanroom version, %2 the reason
+        setError(tr("Couldn't install Cleanroom %1:\n%2").arg(m_cleanroom->tag, reason));
+        return nullptr;
+    }
+
+    return inst;
+}
+
+}  // namespace Cleanroom
