+// SPDX-License-Identifier: GPL-3.0-only
+
+#include <QFile>
+#include <QTest>
+#include <QTimeZone>
+
+#include "minecraft/cleanroom/CleanroomVersionList.h"
+
+class CleanroomVersionListTest : public QObject {
+    Q_OBJECT
+
+   private slots:
+    void test_parseReleases()
+    {
+        QFile file(QFINDTESTDATA("testdata/CleanroomVersionList/releases.json"));
+        QVERIFY(file.open(QIODevice::ReadOnly));
+
+        QString error;
+        const auto versions = Cleanroom::VersionList::parseReleases(file.readAll(), &error);
+        QVERIFY2(error.isEmpty(), qPrintable(error));
+
+        // the draft and the release without an instance zip are skipped
+        QCOMPARE(versions.size(), 2);
+
+        const auto& latest = versions.at(0);
+        QCOMPARE(latest->tag, QString("0.7.11-alpha"));
+        QCOMPARE(latest->descriptor(), QString("0.7.11-alpha"));
+        QCOMPARE(latest->zipName, QString("cleanroom-0.7.11-alpha.zip"));
+        QCOMPARE(latest->zipUrl,
+                 QUrl("https://github.com/CleanroomMC/Cleanroom/releases/download/0.7.11-alpha/cleanroom-0.7.11-alpha.zip"));
+        QCOMPARE(latest->zipSize, qint64(13768));
+        QCOMPARE(latest->publishedAt, QDateTime(QDate(2026, 10, 19), QTime(10, 29, 16), QTimeZone::utc()));
+        QVERIFY(!latest->prerelease);
+        QCOMPARE(latest->typeString(), QString("Alpha"));
+
+        // when several zips match, the one mentioning "mmc" wins
+        const auto& pre = versions.at(1);
+        QCOMPARE(pre->tag, QString("0.7.10-pre"));
+        QCOMPARE(pre->zipName, QString("Cleanroom-MMC-instance-0.7.10-pre.zip"));
+        QVERIFY(pre->prerelease);
+        QCOMPARE(pre->typeString(), QString("Pre-release"));
+    }
+
+    void test_parseReleases_githubError()
+    {
+        QString error;
+        const auto versions =
+            Cleanroom::VersionList::parseReleases(R"({"message": "API rate limit exceeded", "documentation_url": "x"})", &error);
+        QVERIFY(versions.isEmpty());
+        QVERIFY(error.contains("API rate limit exceeded"));
+    }
+
+    void test_parseReleases_invalidJson()
+    {
+        QString error;
+        const auto versions = Cleanroom::VersionList::parseReleases("<html>not json</html>", &error);
+        QVERIFY(versions.isEmpty());
+        QVERIFY(!error.isEmpty());
+    }
+};
+
+QTEST_GUILESS_MAIN(CleanroomVersionListTest)
+
+#include "CleanroomVersionList_test.moc"
