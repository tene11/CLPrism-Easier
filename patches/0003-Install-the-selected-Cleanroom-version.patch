+#include "CleanroomInstallTask.h"
+
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+
+#include <algorithm>
+
+#include "Application.h"
+#include "FileSystem.h"
+#include "MMCZip.h"
+#include "minecraft/Component.h"
+#include "minecraft/MinecraftInstance.h"
+#include "minecraft/PackProfile.h"
+#include "minecraft/ProfileUtils.h"
+#include "net/Download.h"
+
+namespace Cleanroom {
+
+namespace {
+constexpr auto CLEANROOM_UID = "net.minecraftforge";
+constexpr auto MINECRAFT_UID = "net.minecraft";
+
+QString describeProblems(const VersionFilePtr& file)
+{
+    QStringList lines;
+    for (const auto& problem : file->getProblems())
+        lines << problem.m_description;
+    return lines.join('\n');
+}
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// Reading the extracted zip
+// ---------------------------------------------------------------------------
+
+std::optional<InstancePackage> readInstancePackage(const QString& extractedDir, QString* error)
+{
+    auto fail = [error](const QString& reason) -> std::optional<InstancePackage> {
+        if (error)
+            *error = reason;
+        return std::nullopt;
+    };
+
+    const QDir root(extractedDir);
+    const QDir patchesDir(root.filePath("patches"));
+    if (!patchesDir.exists())
+        return fail(QObject::tr("The downloaded file has no \"patches\" folder. Is it really a Cleanroom MMC instance zip?"));
+
+    // mmc-pack.json tells the component order (LWJGL first, then Cleanroom)
+    QStringList order;
+    QFile packFile(root.filePath("mmc-pack.json"));
+    if (packFile.open(QIODevice::ReadOnly)) {
+        const auto components = QJsonDocument::fromJson(packFile.readAll()).object().value("components").toArray();
+        for (const QJsonValue& component : components) {
+            const QString uid = component.toObject().value("uid").toString();
+            if (!uid.isEmpty() && !order.contains(uid))
+                order << uid;
+        }
+    } else {
+        qWarning() << "Cleanroom zip has no readable mmc-pack.json, installing patches in file name order";
+    }
+    // patches that mmc-pack.json doesn't mention still get installed, after the listed ones
+    for (const QFileInfo& info : patchesDir.entryInfoList({ "*.json" }, QDir::Files, QDir::Name)) {
+        if (!order.contains(info.completeBaseName()))
+            order << info.completeBaseName();
+    }
+
+    InstancePackage package;
+    for (const QString& uid : order) {
+        if (uid == MINECRAFT_UID)
+            continue;  // never replace Minecraft itself
+
+        const QString jsonPath = patchesDir.filePath(uid + ".json");
+        if (!QFileInfo::exists(jsonPath)) {
+            // listed in mmc-pack.json but resolved from the meta server: nothing to copy
+            qWarning() << "Cleanroom zip lists" << uid << "without a patch file, skipping it";
+            continue;
+        }
+
+        auto file = ProfileUtils::parseJsonFile(QFileInfo(jsonPath), false);
+        if (!file || file->getProblemSeverity() == ProblemSeverity::Error)
+            return fail(QObject::tr("Couldn't read %1 from the downloaded file:\n%2").arg(uid + ".json", file ? describeProblems(file) : QString()));
+        if (file->uid != uid)
+            return fail(QObject::tr("%1.json in the downloaded file declares the uid \"%2\".").arg(uid, file->uid));
+
+        package.patches.append({ uid, jsonPath, file });
+    }
+
+    const bool hasCleanroom =
+        std::any_of(package.patches.cbegin(), package.patches.cend(), [](const InstancePackage::Patch& patch) { return patch.uid == CLEANROOM_UID; });
+    if (!hasCleanroom)
+        return fail(QObject::tr("The downloaded file doesn't contain patches/%1.json.").arg(CLEANROOM_UID));
+
+    const QDir librariesDir(root.filePath("libraries"));
+    for (const QFileInfo& info : librariesDir.entryInfoList({ "*.jar" }, QDir::Files, QDir::Name))
+        package.libraryJars << info.absoluteFilePath();
+
+    return package;
+}
+
+// ---------------------------------------------------------------------------
+// Applying it to an instance
+// ---------------------------------------------------------------------------
+
+bool installPackage(PackProfile* profile, const InstancePackage& package, QString* error)
+{
+    auto fail = [error](const QString& reason) {
+        if (error)
+            *error = reason;
+        return false;
+    };
+
+    // 1. the empty stub jars that hide vanilla's LWJGL 2 & co. ("MMC-hint": "local" libraries)
+    const QString libDir = profile->instance()->getLocalLibraryPath();
+    if (!package.libraryJars.isEmpty() && !FS::ensureFolderPathExists(libDir)) {
+        return fail(QObject::tr("Couldn't create the folder %1.").arg(libDir));
+    }
+    for (const QString& jar : package.libraryJars) {
+        const QString target = FS::PathCombine(libDir, QFileInfo(jar).fileName());
+        if (QFileInfo::exists(target) && !QFile::remove(target)) {
+            return fail(QObject::tr("Couldn't replace %1.").arg(target));
+        }
+        if (!QFile::copy(jar, target)) {
+            return fail(QObject::tr("Couldn't copy %1 to %2.").arg(QFileInfo(jar).fileName(), libDir));
+        }
+    }
+
+    // 2. replace the components (Forge / LWJGL 2 -> Cleanroom / LWJGL 3)
+    for (const auto& patch : package.patches) {
+        if (profile->getComponent(patch.uid) && !profile->remove(patch.uid)) {
+            return fail(QObject::tr("Couldn't remove the existing %1 component.").arg(patch.uid));
+        }
+
+        const QString target = profile->patchFilePathForUid(patch.uid);
+        if (!FS::ensureFilePathExists(target) || (QFileInfo::exists(target) && !QFile::remove(target)) ||
+            !QFile::copy(patch.jsonPath, target)) {
+            return fail(QObject::tr("Couldn't write %1.").arg(target));
+        }
+
+        profile->appendComponent(makeShared<Component>(profile, patch.uid, patch.file));
+    }
+
+    profile->invalidateLaunchProfile();
+    profile->saveNow();
+    return true;
+}
+
+
+// ---------------------------------------------------------------------------
+// InstallTask
+// ---------------------------------------------------------------------------
+
+InstallTask::InstallTask(PackProfile* profile, Version::Ptr version) : Task(), m_profile(profile), m_version(std::move(version)) {}
+
+bool InstallTask::abort()
+{
+    if (m_job)
+        m_job->abort();
+    return Task::abort();
+}
+
+void InstallTask::executeTask()
+{
+    if (!m_profile || !m_version) {
+        emitFailed(tr("Nothing to install."));
+        return;
+    }
+    if (!m_tempDir.isValid()) {
+        emitFailed(tr("Couldn't create a temporary folder: %1").arg(m_tempDir.errorString()));
+        return;
+    }
+
+    setStatus(tr("Downloading Cleanroom %1...").arg(m_version->tag));
+    m_zipPath = m_tempDir.filePath("cleanroom.zip");
+
+    m_job = makeShared<NetJob>("Cleanroom::Install", APPLICATION->network());
+    m_job->addNetAction(Net::Download::makeFile(m_version->zipUrl, m_zipPath));
+
+    connect(m_job.get(), &NetJob::succeeded, this, &InstallTask::onDownloadSucceeded);
+    connect(m_job.get(), &NetJob::failed, this, [this](QString reason) {
+        m_job.reset();
+        emitFailed(tr("Couldn't download Cleanroom %1: %2").arg(m_version->tag, reason));
+    });
+    connect(m_job.get(), &NetJob::aborted, this, [this] {
+        m_job.reset();
+        emitAborted();
+    });
+    connect(m_job.get(), &NetJob::progress, this, &Task::setProgress);
+
+    m_job->start();
+}
+
+void InstallTask::onDownloadSucceeded()
+{
+    m_job.reset();
+    setStatus(tr("Installing Cleanroom %1...").arg(m_version->tag));
+
+    const QString extracted = m_tempDir.filePath("extracted");
+    if (!MMCZip::extractDir(m_zipPath, extracted)) {
+        emitFailed(tr("Couldn't extract the downloaded Cleanroom zip."));
+        return;
+    }
+
+    QString error;
+    const auto package = readInstancePackage(extracted, &error);
+    if (!package) {
+        emitFailed(error);
+        return;
+    }
+
+    if (!m_profile) {
+        emitFailed(tr("The instance went away during the installation."));
+        return;
+    }
+    if (!installPackage(m_profile.data(), *package, &error)) {
+        emitFailed(error);
+        return;
+    }
+    for (const auto& patch : package->patches) {
+        if (patch.uid == CLEANROOM_UID)
+            m_installedCleanroom = patch.file;
+    }
+    emitSucceeded();
+}
+
+}  // namespace Cleanroom
