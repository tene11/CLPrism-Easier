+
+    void test_requiresOtherLwjgl_data()
+    {
+        QTest::addColumn<QByteArray>("reqs");
+        QTest::addColumn<bool>("other");
+        // Minecraft 1.12.2 from the meta server: LWJGL 2 as org.lwjgl, which Cleanroom replaces
+        QTest::newRow("meta Minecraft") << QByteArray(R"([{"uid": "org.lwjgl", "suggests": "2.9.4-nightly-20150209"}])") << false;
+        // Minecraft customized to require LWJGL 3.3.1: it adds a second LWJGL 3 next to Cleanroom's 3.4.3
+        QTest::newRow("customized Minecraft") << QByteArray(R"([{"uid": "org.lwjgl3", "suggests": "3.3.1"}])") << true;
+        QTest::newRow("among others") << QByteArray(R"([{"uid": "net.minecraft"}, {"uid": "org.lwjgl3", "equals": "3.3.3"}])") << true;
+        QTest::newRow("Cleanroom itself")
+            << QByteArray(R"([{"uid": "net.minecraft", "equals": "1.12.2"}, {"uid": "org.lwjgl", "equals": "3.4.3"}])") << false;
+        QTest::newRow("nothing") << QByteArray("[]") << false;
+    }
+
+    void test_requiresOtherLwjgl()
+    {
+        QFETCH(QByteArray, reqs);
+        QFETCH(bool, other);
+
+        QTemporaryDir dir;
+        const QString path = dir.filePath("net.minecraft.json");
+        write(path, R"({"formatVersion": 1, "uid": "net.minecraft", "name": "Minecraft", "version": "1.12.2", "requires": )" + reqs + "}");
+
+        const auto file = ProfileUtils::parseJsonFile(QFileInfo(path), false);
+        QVERIFY(file);
+        QCOMPARE(Cleanroom::requiresOtherLwjgl(file->m_requires), other);
+    }
 };
 
