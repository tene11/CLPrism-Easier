@@ -77,6 +84,30 @@ class InstallLoaderPage : public VersionSelectWidget, public BasePage {
     bool loaded = false;
 };
 
+//! Cleanroom: a Forge 1.12.2 fork whose versions come from GitHub Releases instead of the meta server.
+class CleanroomLoaderPage : public InstallLoaderPage {
+    Q_OBJECT
+   public:
+    explicit CleanroomLoaderPage(PackProfile* profile)
+        : InstallLoaderPage(Cleanroom::PAGE_ID, "forge", tr("Cleanroom"), {}, profile), m_versions(new Cleanroom::VersionList(this))
+    {
+        const QString minecraftVersion = profile->getComponentVersion("net.minecraft");
+        if (minecraftVersion != Cleanroom::MINECRAFT_VERSION)
+            setEmptyString(tr("Cleanroom only supports Minecraft %1 (this instance uses %2)")
+                               .arg(QString(Cleanroom::MINECRAFT_VERSION), minecraftVersion));
+
+        // Cleanroom installs itself as "net.minecraftforge" named "Cleanroom"; highlight it if present
+        if (auto forge = profile->getComponent("net.minecraftforge"); forge && forge->getName() == "Cleanroom")
+            setCurrentVersion(forge->getVersion());
+    }
+
+   protected:
+    BaseVersionList* versionList() override { return m_versions; }
+
+   private:
+    Cleanroom::VersionList* m_versions;
+};
+
 static InstallLoaderPage* pageCast(BasePage* page)
 {
     auto result = dynamic_cast<InstallLoaderPage*>(page);
